{#
    Parte de servicio para talleres de smartphones/tablets.
    A5 apaisado, dos mitades: copia cliente (izquierda) y copia taller (derecha, con
    checklist de estado físico y firma del cliente).
#}
{% extends "Master/MicroTemplate.html.twig" %}

{% block css %}
    {{ parent() }}
    <style>
        @page {
            size: A5 landscape;
            margin: 8mm;
        }

        body {
            font-size: 11px;
        }

        .no-print {
            margin: 10px;
        }

        .ticket-half {
            font-size: 11px;
        }

        .ticket-half h4 {
            font-size: 13px;
            font-weight: bold;
            border-bottom: 1px solid #999;
            padding-bottom: 2px;
            margin-bottom: 6px;
        }

        .ticket-half h5 {
            font-size: 11px;
            font-weight: bold;
            margin-top: 4px;
            margin-bottom: 3px;
            background: #f2f2f2;
            padding: 2px 6px;
        }

        .field-label {
            font-weight: bold;
            display: block;
            line-height: 1.1;
        }

        .field-value {
            min-height: 12px;
            line-height: 1.1;
            border-bottom: 1px dotted #999;
            margin-bottom: 3px;
        }

        .signature-box {
            margin-top: 8px;
            border-top: 1px solid #000;
            padding-top: 2px;
            text-align: center;
        }

        .legal-text {
            font-size: 8px;
            color: #555;
            margin-top: 4px;
        }

        @media print {
            .no-print {
                display: none !important;
            }

            .ticket-divider {
                border-left: 1px dashed #999;
            }
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            window.print();
        });
    </script>
{% endblock %}

{% block messages %}{% endblock %}

{% block body %}
    {% macro field(label, value) %}
        <span class="field-label">{{ label }}</span>
        <span class="field-value">{{ (value is empty) ? '-' : value }}</span>
    {% endmacro %}

    {% macro parte(fsc, taller) %}
        <div class="ticket-half">
            <h4>{{ trans('ticket-label') }}: {{ fsc.servicio.codigo }}</h4>

            <div class="row">
                <div class="col-6">
                    {{ _self.field(trans('date'), fsc.servicio.fecha) }}
                </div>
                <div class="col-6">
                    {{ _self.field(trans('hour'), fsc.servicio.hora) }}
                </div>
            </div>

            <div class="row">
                <div class="col-8">
                    {{ _self.field(trans('customer'), fsc.cliente.nombre) }}
                </div>
                <div class="col-4">
                    {{ _self.field(trans('phone'), fsc.servicio.telefono1) }}
                </div>
            </div>

            <div class="row">
                <div class="col-4">
                    {{ _self.field(trans('ts-brand'), fsc.servicio.ts_marca) }}
                </div>
                <div class="col-4">
                    {{ _self.field(trans('model'), fsc.servicio.ts_modelo) }}
                </div>
                <div class="col-4">
                    {{ _self.field(trans('color'), fsc.servicio.ts_color) }}
                </div>
            </div>

            <div class="row">
                <div class="col-6">
                    {{ _self.field(trans('ts-imei'), fsc.servicio.ts_imei) }}
                </div>
                <div class="col-6">
                    {{ _self.field(trans('ts-unlock-code'), fsc.servicio.ts_codigo_desbloqueo) }}
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    {{ _self.field(trans('ts-device-condition'), fsc.servicio.ts_condicion_equipo) }}
                </div>
            </div>

            {% if taller %}
                <h5>{{ trans('device-checklist') }}</h5>
                <div class="row">
                    <div class="col-4">
                        {{ _self.field(trans('ts-lcd-screen'), fsc.servicio.ts_lcd) }}
                    </div>
                    <div class="col-4">
                        {{ _self.field(trans('ts-touch-screen'), fsc.servicio.ts_touch) }}
                    </div>
                    <div class="col-4">
                        {{ _self.field(trans('ts-fingerprint-face'), fsc.servicio.ts_huella_face) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-4">
                        {{ _self.field(trans('ts-cameras'), fsc.servicio.ts_camaras) }}
                    </div>
                    <div class="col-4">
                        {{ _self.field(trans('ts-wifi-bluetooth'), fsc.servicio.ts_wifi_bluetooth) }}
                    </div>
                    <div class="col-4">
                        {{ _self.field(trans('ts-speakers'), fsc.servicio.ts_altavoces) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-4">
                        {{ _self.field(trans('ts-network'), fsc.servicio.ts_red) }}
                    </div>
                    <div class="col-4">
                        {{ _self.field(trans('ts-earpiece'), fsc.servicio.ts_auricular) }}
                    </div>
                    <div class="col-4">
                        {{ _self.field(trans('ts-back-cover'), fsc.servicio.ts_tapa) }}
                    </div>
                </div>
            {% endif %}

            <div class="row">
                <div class="col-12">
                    {{ _self.field(trans('description'), fsc.servicio.descripcion) }}
                </div>
                <div class="col-12">
                    {{ _self.field(trans('solution'), fsc.servicio.solucion) }}
                </div>
                <div class="col-12">
                    {{ _self.field(trans('observations'), fsc.servicio.observaciones) }}
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    {{ _self.field(trans('served-by'), fsc.agente.nombre ?? fsc.servicio.nick) }}
                </div>
            </div>

            {% if taller %}
                <div class="signature-box">
                    {{ trans('customer-signature') }}
                </div>
                <p class="legal-text">{{ trans('signature-acceptance-notice') }}</p>
            {% endif %}
        </div>
    {% endmacro %}

    <div class="no-print p-2 bg-light border-bottom">
        <strong>{{ trans('print-landscape-reminder') }}</strong>
        (A5 {{ trans('landscape') }})
    </div>

    <div class="container-fluid">
        <div class="row">
            <div class="col-6">
                {{ _self.parte(fsc, false) }}
            </div>
            <div class="col-6 ticket-divider">
                {{ _self.parte(fsc, true) }}
            </div>
        </div>
    </div>
{% endblock %}
