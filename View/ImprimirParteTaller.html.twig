{#
    Parte de servicio para talleres de smartphones/tablets.
    A5 apaisado, dos mitades: copia cliente (izquierda) y copia taller (derecha, con
    checklist de estado físico y firma del cliente).
#}
{% extends "Master/MicroTemplate.html.twig" %}

{% block css %}
    {{ parent() }}
    <style>
        @page {
            size: A5 landscape;
            margin: 8mm;
        }

        body {
            font-size: 10px;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        .no-print {
            margin: 10px;
        }

        .ticket-half {
            font-size: 10px;
            height: 132mm;
            display: flex;
            flex-direction: column;
            color: #212529;
        }

        .ticket-content {
            flex: 0 0 auto;
        }

        .signature-spacer {
            flex: 1 1 auto;
            min-height: 6px;
        }

        .ticket-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            flex-wrap: wrap;
            border-bottom: 2px solid #34519e;
            padding-bottom: 3px;
            margin-bottom: 6px;
        }

        .ticket-header-title {
            font-size: 15px;
            font-weight: 700;
            color: #22314f;
        }

        .ticket-header-title .code {
            font-weight: 400;
            color: #555;
            margin-left: 5px;
            font-size: 12px;
        }

        .ticket-header-meta {
            font-size: 10px;
            color: #555;
            text-align: right;
        }

        .ticket-header-meta strong {
            color: #222;
        }

        .ticket-header-meta .sep {
            margin: 0 6px;
            color: #c2c2c2;
        }

        .section {
            border: 1px solid #e3e6ea;
            border-left: 3px solid #34519e;
            border-radius: 4px;
            background: #fafbfc;
            padding: 3px 8px;
            margin-bottom: 4px;
        }

        .section-title {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: #34519e;
            margin-bottom: 3px;
        }

        .field-inline {
            margin-bottom: 2px;
        }

        /* Patrón de desbloqueo: arriba a la derecha de «Datos del dispositivo», sin sumar alto. */
        .section.con-patron {
            position: relative;
            padding-right: 58px;
        }

        .patron-desbloqueo {
            position: absolute;
            top: 4px;
            right: 6px;
            width: 46px;
            height: 46px;
        }

        .field-inline .field-label {
            font-weight: 700;
        }

        .field-inline .field-label::after {
            content: ':';
            margin-right: 4px;
        }

        .field-block {
            margin-bottom: 4px;
        }

        .field-block:last-child {
            margin-bottom: 0;
        }

        .field-block .field-label {
            display: block;
            font-weight: 700;
            margin-bottom: 1px;
        }

        .field-block .field-value {
            display: block;
        }

        .checklist-grid {
            display: flex;
            flex-wrap: wrap;
        }

        .checklist-grid .field-inline {
            flex: 0 0 33.33%;
        }

        .signature-box {
            flex: 0 0 auto;
            border-top: 1px solid #000;
            padding-top: 3px;
            text-align: center;
        }

        .legal-text {
            flex: 0 0 auto;
            font-size: 8px;
            color: #555;
            margin-top: 4px;
            margin-bottom: 0;
        }

        @media print {
            .no-print {
                display: none !important;
            }

            .ticket-divider {
                border-left: 1px dashed #999;
            }

            .section {
                background: #fff;
            }
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            window.print();
        });
    </script>
{% endblock %}

{% block messages %}{% endblock %}

{% block body %}
    {% macro fieldInline(label, value) %}
        <div class="field-inline"><span class="field-label">{{ label }}</span> <span class="field-value">{{ (value is empty) ? '-' : value }}</span></div>
    {% endmacro %}

    {% macro fieldBlock(label, value) %}
        <div class="field-block"><span class="field-label">{{ label }}</span><span class="field-value">{{ (value is empty) ? '-' : value }}</span></div>
    {% endmacro %}

    {% macro patron(p) %}
        <svg class="patron-desbloqueo" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
            {% for y in 0..2 %}{% for x in 0..2 %}
                <circle cx="{{ 10 + x * 20 }}" cy="{{ 10 + y * 20 }}" r="2.5" fill="#c2c7d0"/>
            {% endfor %}{% endfor %}
            <polyline points="{% for q in p.puntos %}{{ 10 + q.x * 20 }},{{ 10 + q.y * 20 }} {% endfor %}" fill="none" stroke="#34519e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            {% for q in p.puntos %}
                <circle cx="{{ 10 + q.x * 20 }}" cy="{{ 10 + q.y * 20 }}" r="3.5" fill="#34519e"/>
            {% endfor %}
            {% set i = p.puntos|first %}
            <circle cx="{{ 10 + i.x * 20 }}" cy="{{ 10 + i.y * 20 }}" r="7" fill="none" stroke="#34519e" stroke-width="1.5"/>
        </svg>
    {% endmacro %}

    {% macro parte(fsc, taller) %}
        {% set patron = taller ? fsc.patronDesbloqueo() : null %}
        <div class="ticket-half">
        <div class="ticket-content">
            <div class="ticket-header">
                <div class="ticket-header-title">
                    {{ trans('ticket-label') }}<span class="code">{{ fsc.servicio.codigo }}</span>
                </div>
                <div class="ticket-header-meta">
                    {{ trans('date') }} <strong>{{ fsc.servicio.fecha }}</strong>
                    <span class="sep">&bull;</span>
                    {{ trans('hour') }} <strong>{{ fsc.servicio.hora }}</strong>
                    <span class="sep">&bull;</span>
                    {{ trans('served-by') }} <strong>{{ (fsc.agente.nombre ?? fsc.servicio.nick) is empty ? '-' : (fsc.agente.nombre ?? fsc.servicio.nick) }}</strong>
                </div>
            </div>

            <div class="section">
                <div class="section-title">{{ trans('customer') }}</div>
                <div class="row">
                    <div class="col-8">
                        {{ _self.fieldInline(trans('customer'), fsc.cliente.nombre) }}
                    </div>
                    <div class="col-4">
                        {{ _self.fieldInline(trans('phone'), fsc.servicio.telefono1) }}
                    </div>
                </div>
            </div>

            <div class="section{{ patron ? ' con-patron' : '' }}">
                {% if patron %}{{ _self.patron(patron) }}{% endif %}
                <div class="section-title">{{ trans('device-data') }}</div>
                <div class="row">
                    <div class="col-4">
                        {{ _self.fieldInline(trans('ts-brand'), fsc.servicio.ts_marca) }}
                    </div>
                    <div class="col-4">
                        {{ _self.fieldInline(trans('model'), fsc.servicio.ts_modelo) }}
                    </div>
                    <div class="col-4">
                        {{ _self.fieldInline(trans('color'), fsc.servicio.ts_color) }}
                    </div>
                </div>
                <div class="row">
                    <div class="{{ taller ? 'col-6' : 'col-12' }}">
                        {{ _self.fieldInline(trans('ts-imei'), fsc.servicio.ts_imei) }}
                    </div>
                    {% if taller %}
                    <div class="col-6">
                        {% if patron %}
                            {{ _self.fieldInline(trans('ts-unlock-code'), patron.secuencia ~ (patron.texto ? ' · ' ~ patron.texto : '')) }}
                        {% else %}
                            {{ _self.fieldInline(trans('ts-unlock-code'), fsc.servicio.ts_codigo_desbloqueo) }}
                        {% endif %}
                    </div>
                    {% endif %}
                </div>
                <div class="row">
                    <div class="col-12">
                        {{ _self.fieldBlock(trans('ts-device-condition'), fsc.servicio.ts_condicion_equipo) }}
                    </div>
                </div>
            </div>

            <div class="section">
                <div class="section-title">{{ trans('device-checklist') }}</div>
                <div class="checklist-grid">
                    {{ _self.fieldInline(trans('ts-lcd-screen'), fsc.servicio.ts_lcd) }}
                    {{ _self.fieldInline(trans('ts-touch-screen'), fsc.servicio.ts_touch) }}
                    {{ _self.fieldInline(trans('ts-fingerprint-face'), fsc.servicio.ts_huella_face) }}
                    {{ _self.fieldInline(trans('ts-cameras'), fsc.servicio.ts_camaras) }}
                    {{ _self.fieldInline(trans('ts-wifi-bluetooth'), fsc.servicio.ts_wifi_bluetooth) }}
                    {{ _self.fieldInline(trans('ts-speakers'), fsc.servicio.ts_altavoces) }}
                    {{ _self.fieldInline(trans('ts-network'), fsc.servicio.ts_red) }}
                    {{ _self.fieldInline(trans('ts-earpiece'), fsc.servicio.ts_auricular) }}
                    {{ _self.fieldInline(trans('ts-back-cover'), fsc.servicio.ts_tapa) }}
                </div>
            </div>

            <div class="section">
                <div class="section-title">{{ trans('diagnosis') }}</div>
                {{ _self.fieldBlock(trans('description'), fsc.servicio.descripcion) }}
                {{ _self.fieldBlock(trans('solution'), fsc.servicio.solucion) }}
                {{ _self.fieldBlock(trans('observations'), fsc.servicio.observaciones) }}
            </div>
        </div>

            {% if taller %}
                <div class="signature-spacer"></div>
                <div class="signature-box">
                    {{ trans('customer-signature') }}
                </div>
                <p class="legal-text">{{ trans('signature-acceptance-notice') }}</p>
            {% endif %}
        </div>
    {% endmacro %}

    <div class="no-print p-2 bg-light border-bottom">
        <strong>{{ trans('print-landscape-reminder') }}</strong>
        (A5 {{ trans('landscape') }})
    </div>

    <div class="container-fluid">
        <div class="row">
            <div class="col-6">
                {{ _self.parte(fsc, false) }}
            </div>
            <div class="col-6 ticket-divider">
                {{ _self.parte(fsc, true) }}
            </div>
        </div>
    </div>
{% endblock %}
